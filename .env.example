# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

# Use when migrate
DATABASE_URL_UNPOOLED=
# Neon for `main` branch, db:migrate:prod
PROD_DATABASE_URL=
# Neon for `preview` branch on Neon, db:migrate:preview and db:seed:preview
PREVIEW_DATABASE_URL=

# Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=algorithms_visualization
REDIS_PASSWORD=redis
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq

# Redis
REDIS_URL=redis://:redis@localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:rabbitmq@localhost:5672

# Agents
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP (App Password: https://myaccount.google.com/apppasswords)
GMAIL_SMTP_HOST=
GMAIL_SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
