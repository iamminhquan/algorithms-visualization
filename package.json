{
  "name": "algorithms-visualization",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "test": "bun test",
    "format": "biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "DATABASE_URL=$PROD_DATABASE_URL DATABASE_URL_UNPOOLED=$PROD_DATABASE_URL drizzle-kit migrate",
    "db:migrate:preview": "DATABASE_URL=$PREVIEW_DATABASE_URL DATABASE_URL_UNPOOLED=$PREVIEW_DATABASE_URL drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun --conditions=react-server db/seed.ts && bun --conditions=react-server db/seed-snippets.ts",
    "db:seed:snippets": "bun --conditions=react-server db/seed-snippets.ts",
    "db:seed:admin": "bun --conditions=react-server db/seed-admin.ts",
    "db:seed:preview": "DATABASE_URL=$PREVIEW_DATABASE_URL bun --conditions=react-server db/seed.ts && DATABASE_URL=$PREVIEW_DATABASE_URL bun --conditions=react-server db/seed-snippets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@next/env": "^16.4.2",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "redis": "^6.3.0",
    "server-only": "^0.0.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.3",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
