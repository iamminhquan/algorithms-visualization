    "algorithmKey": "merge-sort",
    "kind": "source",
    "language": "cpp",
    "lines": [
      "const int MAX_N = 100;",
      "",
      "void merge(int a[], int lo, int mid, int hi) {",
      "    int left[MAX_N];",
      "    int right[MAX_N];",
      "    int n1 = mid - lo + 1;",
      "    int n2 = hi - mid;",
      "    for (int i = 0; i < n1; i++) {",
      "        left[i] = a[lo + i];",
      "    }",
      "    for (int j = 0; j < n2; j++) {",
      "        right[j] = a[mid + 1 + j];",
      "    }",
      "    int i = 0;",
      "    int j = 0;",
      "    for (int k = lo; k <= hi; k++) {",
      "        if (j == n2 || (i < n1 && left[i] <= right[j])) {",
      "            a[k] = left[i++];",
      "        } else {",
      "            a[k] = right[j++];",
      "        }",
      "    }",
      "}",
      "",
      "void merge_sort(int a[], int lo, int hi) {",
      "    if (lo >= hi) {",
      "        return;",
      "    }",
      "    int mid = lo + (hi - lo) / 2;",
      "    merge_sort(a, lo, mid);",
      "    merge_sort(a, mid + 1, hi);",
      "    merge(a, lo, mid, hi);",
      "}"
    ]
  },
