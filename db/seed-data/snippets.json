      "#include <iostream>",
      "#include <utility>",
      "",
      "void insertion_sort(int a[], int n) {",
      "    for (int i = 1; i < n; i++) {",
      "        for (int j = i; j > 0; j--) {",
      "            if (a[j - 1] <= a[j]) {",
      "                break;",
      "            }",
      "            std::swap(a[j - 1], a[j]);",
      "        }",
      "    }",
      "}",
      "",
      "int main() {",
      "    int a[] = {38, 27, 43, 3, 9, 82, 10, 55, 19, 64};",
      "    int n = static_cast<int>(sizeof(a) / sizeof(a[0]));",
      "    insertion_sort(a, n);",
      "    for (int i = 0; i < n; i++) {",
      "        std::cout << a[i] << ' ';",
      "    }",
      "    std::cout << '\\n';",
      "    return 0;",
      "}"
    ]
  },
