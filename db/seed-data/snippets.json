    "lines": [
      "void quick_sort(int arr[], int left, int right) {",
      "    if (left >= right) return;",
      "",
      "    int i = left;",
      "    int j = right;",
      "    int pivot = arr[left + (right - left) / 2];",
      "",
      "    do {",
      "        while (arr[i] < pivot) ++i;",
      "        while (arr[j] > pivot) --j;",
      "",
      "        if (i <= j) {",
      "            std::swap(arr[i], arr[j]);",
      "            ++i;",
      "            --j;",
      "        }",
      "    } while (i <= j);",
      "",
      "    if (left < j) {",
      "        quick_sort(arr, left, j);",
      "    }",
      "",
      "    if (i < right) {",
      "        quick_sort(arr, i, right);",
      "    }",
      "}"
    ]
  },
