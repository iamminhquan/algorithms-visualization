      "hàm quick_sort(left, right)",
      "  nếu left > right: trả về",
      "  nếu left == right:",
      "    a[left] đã đúng vị trí",
      "    trả về",
      "  i = left",
      "  j = right",
      "  pivot = a[left + (right - left) / 2]",
      "  lặp",
      "    trong khi i <= right và a[i] < pivot",
      "      i tăng 1",
      "    trong khi j >= left và a[j] > pivot",
      "      j giảm 1",
      "    nếu i <= j",
      "      nếu a[i] != a[j]: hoán đổi a[i], a[j]",
      "      i = i + 1",
      "      j = j - 1",
      "  trong khi i <= j",
      "  nếu left < j: quick_sort(left, j)",
      "  nếu i < right: quick_sort(i, right)",
      "quick_sort(0, n - 1)",
      "kết thúc"
    ]
