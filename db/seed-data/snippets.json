    "language": "cpp",
    "lines": [
      "int binary_search(const int a[], int n, int key) {",
      "    int low = 0;",
      "    int high = n - 1;",
      "    while (low <= high) {",
      "        int mid = low + (high - low) / 2;",
      "        if (a[mid] == key) {",
      "            return mid;",
      "        }",
      "        if (a[mid] < key) {",
      "            low = mid + 1;",
      "        } else {",
      "            high = mid - 1;",
      "        }",
      "    }",
      "    return -1;",
      "}"
    ]
  },
