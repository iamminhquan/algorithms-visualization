    "algorithmKey": "binary-search",
    "kind": "source",
    "language": "cpp",
    "lines": [
      "#include <iostream>",
      "",
      "int binary_search(const int a[], int n, int key) {",
      "    int low = 0;",
      "    int high = n - 1;",
      "    while (low <= high) {",
      "        int mid = low + (high - low) / 2;",
      "        if (a[mid] == key) {",
      "            return mid;",
      "        }",
      "        if (a[mid] < key) {",
      "            low = mid + 1;",
      "        } else {",
      "            high = mid - 1;",
      "        }",
      "    }",
      "    return -1;",
      "}",
      "",
      "int main() {",
      "    int a[] = {3, 9, 10, 19, 27, 38, 43, 55, 64, 82};",
      "    int n = static_cast<int>(sizeof(a) / sizeof(a[0]));",
      "    int key = 19;",
      "    int index = binary_search(a, n, key);",
      "    if (index != -1) {",
      "        std::cout << \"Found \" << key << \" at index \" << index << '\\n';",
      "    } else {",
      "        std::cout << key << \" not found\" << '\\n';",
      "    }",
      "    return 0;",
      "}"
    ]
  },
