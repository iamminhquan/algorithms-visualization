    "lines": [
      "void selection_sort(int a[], int n) {",
      "    for (int i = 0; i < n - 1; i++) {",
      "        int min = i;",
      "        for (int j = i + 1; j < n; j++) {",
      "            if (a[j] < a[min]) {",
      "                min = j;",
      "            }",
      "        }",
      "        if (min != i) {",
      "            std::swap(a[i], a[min]);",
      "        }",
      "    }",
      "}"
    ]
  },
