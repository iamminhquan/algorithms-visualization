    "algorithmKey": "bubble-sort",
    "kind": "source",
    "language": "cpp",
    "lines": [
      "void bubble_sort(int a[], int n) {",
      "    for (int end = n - 1; end >= 1; end--) {",
      "        bool swapped = false;",
      "        for (int i = 0; i < end; i++) {",
      "            if (a[i] > a[i + 1]) {",
      "                std::swap(a[i], a[i + 1]);",
      "                swapped = true;",
      "            }",
      "        }",
      "        if (!swapped) {",
      "            break;",
      "        }",
      "    }",
      "}"
    ]
  },
