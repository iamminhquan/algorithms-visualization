    "lines": [
      "void insertion_sort(int a[], int n) {",
      "    for (int i = 1; i < n; i++) {",
      "        for (int j = i; j > 0; j--) {",
      "            if (a[j - 1] <= a[j]) {",
      "                break;",
      "            }",
      "            std::swap(a[j - 1], a[j]);",
      "        }",
      "    }",
      "}"
    ]
  },
