    "kind": "source",
    "language": "cpp",
    "lines": [
      "#include <iostream>",
      "#include <utility>",
      "",
      "int partition(int a[], int lo, int hi) {",
      "    int pivot = a[hi];",
      "    int i = lo - 1;",
      "    for (int j = lo; j < hi; j++) {",
      "        if (a[j] <= pivot) {",
      "            i++;",
      "            std::swap(a[i], a[j]);",
      "        }",
      "    }",
      "    std::swap(a[i + 1], a[hi]);",
      "    return i + 1;",
      "}",
      "",
      "void quick_sort(int a[], int lo, int hi) {",
      "    if (lo >= hi) {",
      "        return;",
      "    }",
      "    int p = partition(a, lo, hi);",
      "    quick_sort(a, lo, p - 1);",
      "    quick_sort(a, p + 1, hi);",
      "}",
      "",
      "int main() {",
      "    int a[] = {38, 27, 43, 3, 9, 82, 10, 55, 19, 64};",
      "    int n = static_cast<int>(sizeof(a) / sizeof(a[0]));",
      "    quick_sort(a, 0, n - 1);",
      "    for (int i = 0; i < n; i++) {",
      "        std::cout << a[i] << ' ';",
      "    }",
      "    std::cout << '\\n';",
      "    return 0;",
      "}"
    ]
  },
