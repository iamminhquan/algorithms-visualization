    "kind": "source",
    "language": "cpp",
    "lines": [
      "#include <iostream>",
      "#include <utility>",
      "",
      "void bubble_sort(int a[], int n) {",
      "    for (int end = n - 1; end >= 1; end--) {",
      "        bool swapped = false;",
      "        for (int i = 0; i < end; i++) {",
      "            if (a[i] > a[i + 1]) {",
      "                std::swap(a[i], a[i + 1]);",
      "                swapped = true;",
      "            }",
      "        }",
      "        if (!swapped) {",
      "            break;",
      "        }",
      "    }",
      "}",
      "",
      "int main() {",
      "    int a[] = {38, 27, 43, 3, 9, 82, 10, 55, 19, 64};",
      "    int n = static_cast<int>(sizeof(a) / sizeof(a[0]));",
      "    bubble_sort(a, n);",
      "    for (int i = 0; i < n; i++) {",
      "        std::cout << a[i] << ' ';",
      "    }",
      "    std::cout << '\\n';",
      "    return 0;",
      "}"
    ]
  },
